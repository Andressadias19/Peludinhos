# ---------------------------------------------------------------
# VALIDAÇÃO LOCAL COM O SUPABASE REAL (backend local -> banco e Storage do projeto Supabase)
# Copie para .env.supabase.local (ignorado pelo Git) e preencha nesta máquina. Nunca envie os valores por chat.
# Este arquivo é lido SOZINHO (npm.cmd run start:supabase): o .env de desenvolvimento não é usado, então
# tudo o que o backend precisa está aqui. Confira antes com: npm.cmd run supabase:verificar
# Os testes automatizados recusam este arquivo e nunca acessam o Supabase.
# ---------------------------------------------------------------

# Porta diferente da do desenvolvimento (3001), para os dois poderem rodar ao mesmo tempo.
PORT=3002
SERVE_FRONTEND=false
# Frontend local (npm run dev) em http://localhost:5173 e http://127.0.0.1:5173; sem valor, valem as origens locais.
CORS_ORIGIN=
# Liga GET /api/teste-banco só nesta validação local (confere a conexão com o banco). Na hospedagem, false.
DIAGNOSTICO_BANCO=true

# Segredo NOVO, diferente do .env e do .env.test (e diferente do que será usado no Render).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=gere_um_segredo_so_para_a_validacao

# --- Banco: Supabase > Connect > Session pooler (porta 5432) ---
# Cole a URI do Session pooler e troque [YOUR-PASSWORD] pela senha do banco (caracteres especiais codificados: @ vira %40).
# Formato: postgresql://postgres.<projeto>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Não acrescente sslmode nem outros parâmetros: o SSL é configurado abaixo.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Certificado baixado em Database Settings > SSL Configuration, salvo como certificados/supabase-ca.crt
# (pasta certificados/ na raiz do projeto, ignorada pelo Git). O certificado do servidor é sempre verificado.
DATABASE_SSL_CA_FILE=certificados/supabase-ca.crt
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000

# --- Storage ---
STORAGE_DRIVER=supabase
# Project Settings > API: URL do projeto (o mesmo <projeto> da DATABASE_URL).
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Project Settings > API Keys: chave SECRETA service role (não a anon/publishable). Só neste arquivo.
SUPABASE_SERVICE_ROLE_KEY=coloque_a_chave_service_role
SUPABASE_BUCKET_PUBLICO=peludinhos-publico
SUPABASE_BUCKET_PRIVADO=peludinhos-privado
SUPABASE_TIMEOUT_MS=15000
