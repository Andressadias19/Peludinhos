# ---------------------------------------------------------------
# AMBIENTE DOS TESTES AUTOMATIZADOS
# Copie para .env.test (não versionado) e preencha. Veja a seção "Testes" do README.
# Os testes leem só este arquivo: o .env de desenvolvimento nunca é usado para conectar.
# ---------------------------------------------------------------

# PostgreSQL LOCAL, banco e usuário exclusivos de testes.
# Os testes são bloqueados se: o host não for local; DB_NAME não terminar em _test ou for o banco do .env;
# DB_USER for postgres ou o usuário do .env; o banco conectado não tiver o marcador de testes;
# ou o usuário for superusuário. DATABASE_URL não é aceita aqui.
DB_HOST=localhost
DB_PORT=5432
DB_USER=peludinhos_test_user
DB_PASSWORD=coloque_a_senha_do_usuario_de_testes
DB_NAME=peludinhos_test

# Segredo próprio dos testes, diferente do JWT_SECRET do .env.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=gere_um_segredo_so_para_testes

# Pastas de fotos dos testes (públicas e privadas), relativas à raiz do projeto.
# Não podem ser, conter nem ficar dentro de server/uploads e server/uploads-perdidos.
# npm run test:preparar esvazia essas pastas.
UPLOADS_DIR=tests/tmp/uploads
UPLOADS_PRIVATE_DIR=tests/tmp/uploads-perdidos

# Armazenamento das fotos nos testes: sempre o driver local, nas pastas acima.
# Qualquer outro valor bloqueia os testes; variáveis SUPABASE_* também não são aceitas.
STORAGE_DRIVER=local
