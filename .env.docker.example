# Copie este arquivo para .env.docker e preencha os três valores vazios.
# Gere cada valor com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Para POSTGRES_PASSWORD, use o valor hexadecimal gerado (sem caracteres especiais).
POSTGRES_PASSWORD=
JWT_SECRET=

# Conta administrativa apenas para a demonstração local do Docker.
DEMO_ADMIN_EMAIL=demo@peludinhos.local
DEMO_ADMIN_PASSWORD=
