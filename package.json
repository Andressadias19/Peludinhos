{
  "name": "peludinhos",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:preparar && node --test --test-concurrency=1 \"tests/*.test.cjs\" \"tests/*.test.mjs\"",
    "test:preparar": "node tests/helpers/prepararBancoTeste.cjs",
    "test:isolamento": "node --test tests/isolamento.test.cjs",
    "test:armazenamento": "node --test tests/armazenamento.test.cjs",
    "test:supabase": "node --test tests/armazenamento-supabase.test.cjs",
    "test:estrutura": "node --test tests/estrutura-banco.test.cjs",
    "test:ambiente": "node --test tests/ambiente-alternativo.test.cjs tests/limpeza-validacao.test.cjs",
    "test:avistamentos": "node --test tests/avistamentos.test.cjs",
    "test:perdidos": "node --test tests/perdidos.test.cjs",
    "start": "node server/server.js",
    "start:full": "npm run build && node server/server.js --serve-frontend",
    "start:supabase": "npm run supabase:verificar && node server/server.js --arquivo-env=.env.supabase.local",
    "supabase:verificar": "node scripts/verificar-config-supabase.cjs",
    "supabase:limpar-validacao": "node scripts/limpar-validacao-supabase.cjs",
    "dev": "vite",
    "dev:api": "node --watch server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "test:animais": "node --test tests/animais.test.cjs",
    "test:admin": "node --test --test-concurrency=1 tests/admin.test.cjs tests/admin-animais.test.cjs tests/admin-avistamentos.test.cjs tests/admin-desaparecimentos.test.cjs tests/admin-usuarios.test.cjs tests/admin-validacoes.test.cjs tests/admin-regras-vinculo.test.cjs",
    "test:seguranca": "node --test tests/seguranca.test.cjs",
    "test:banco": "node --test tests/database-config.test.cjs",
    "test:servidor": "node --test tests/servidor.test.cjs",
    "test:frontend": "node --test tests/frontend-api.test.mjs"
  },
