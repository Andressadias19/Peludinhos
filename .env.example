# ---------------------------------------------------------------
# BANCO DE DADOS
# Use DATABASE_URL (banco remoto, ex.: Supabase) OU as variáveis DB_* (PostgreSQL local).
# Se DATABASE_URL estiver definida, ela tem prioridade e as DB_* são ignoradas.
# ---------------------------------------------------------------

# PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=coloque_sua_senha
DB_NAME=peludinhos

# Banco remoto. No Supabase, use a conexão "Session pooler" (porta 5432, compatível com IPv4).
# Caracteres especiais da senha precisam estar codificados na URL (ex.: @ vira %40).
# Não inclua sslmode nem outros parâmetros de SSL na URL: configure o SSL abaixo.
# DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# SSL: true para bancos remotos. O certificado do servidor é sempre verificado.
DATABASE_SSL=false

# Certificado da autoridade certificadora (CA), em formato PEM, quando o servidor exigir
# (no Supabase: Database Settings > SSL Configuration > Download certificate).
# Use apenas uma das opções. Em DATABASE_SSL_CA, as quebras de linha podem ser escritas como \n.
# DATABASE_SSL_CA_FILE: relativo à raiz do projeto ou absoluto (no Render, um Secret File: /etc/secrets/supabase-ca.crt).
# DATABASE_SSL_CA_FILE=caminho/para/certificado.crt
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Máximo de conexões simultâneas do pool (1 a 100). Padrão: 10.
# No plano gratuito do Supabase, prefira um valor menor, como 5.
DB_POOL_MAX=10

# Tempo máximo, em milissegundos, para abrir uma conexão com o banco (1000 a 120000). Padrão: 10000.
# Se o banco não responder nesse prazo, a requisição recebe erro em vez de esperar indefinidamente.
DB_CONNECTION_TIMEOUT_MS=10000

# ---------------------------------------------------------------
# SERVIDOR
# ---------------------------------------------------------------
PORT=3001
# Segredo dos tokens de login: obrigatório, com pelo menos 32 caracteres; o servidor não inicia com este texto de exemplo.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use um segredo diferente em cada ambiente (desenvolvimento, testes, produção).
JWT_SECRET=gere_um_segredo_aleatorio

# false (padrão): o Express serve somente a API e as fotos; o frontend roda separado (npm run dev ou hospedagem própria).
# true: o Express também entrega o frontend compilado (pasta dist) e as rotas da SPA.
# O script npm run start:full ativa esse modo sozinho, sem precisar alterar esta variável.
SERVE_FRONTEND=false

# true liga GET /api/teste-banco (consulta o banco sem login), útil para conferir a conexão em desenvolvimento.
# Padrão: false (a rota responde 404). Em produção, deixe false; a rota de saúde é GET /api.
DIAGNOSTICO_BANCO=true

# Origens (endereço do frontend) autorizadas a chamar a API pelo navegador, separadas por vírgula.
# Sem valor, valem as origens locais do Vite: http://localhost:5173, http://127.0.0.1:5173,
# http://localhost:4173 e http://127.0.0.1:4173. Em produção, informe a URL do frontend hospedado.
# Use apenas origens completas (https://exemplo.com), sem caminho; "*" não é aceito.
# CORS é uma regra do navegador: não substitui o login (JWT) nem as permissões da API.
# CORS_ORIGIN=https://seu-frontend.onrender.com

# ---------------------------------------------------------------
# ARMAZENAMENTO DAS FOTOS
# local (padrão): pastas do disco do servidor (UPLOADS_DIR e UPLOADS_PRIVATE_DIR, abaixo).
# supabase: buckets do Supabase Storage (variáveis SUPABASE_*, mais abaixo; só são lidas neste modo).
# Outros valores, ou o modo supabase com configuração incompleta, impedem o servidor de iniciar.
# Trocar de driver não copia as fotos existentes: as que ficaram no outro lugar deixam de aparecer.
# ---------------------------------------------------------------
STORAGE_DRIVER=local

# Pastas das fotos no disco (driver local), relativas à raiz do projeto. Sem valor, valem as pastas de sempre.
# UPLOADS_DIR: fotos públicas, servidas em /uploads (animais, avistamentos, desaparecimentos). Padrão: server/uploads.
# UPLOADS_PRIVATE_DIR: fotos de perfil, entregues só pela API com login. Padrão: server/uploads-perdidos
# (o nome da pasta vem da política anterior; ela também guarda as fotos antigas de desaparecimentos).
# Precisam ser pastas diferentes, sem uma dentro da outra (senão as fotos privadas ficariam públicas).
# Os testes usam pastas próprias, definidas no .env.test.
# UPLOADS_DIR=server/uploads
# UPLOADS_PRIVATE_DIR=server/uploads-perdidos

# --- Supabase Storage (só com STORAGE_DRIVER=supabase) ---
# Endereço do projeto (Project Settings > API), sem caminho: https://<projeto>.supabase.co
# SUPABASE_URL=https://seu-projeto.supabase.co
# Chave SECRETA service role (Project Settings > API Keys). Fica SÓ no backend:
# nunca a coloque em variáveis VITE_*, no frontend, em commits ou em mensagens de log.
# A chave anon/publishable é recusada: ela não tem acesso aos buckets privados.
# SUPABASE_SERVICE_ROLE_KEY=coloque_a_chave_service_role
# Buckets (precisam existir e ser diferentes). Padrões: peludinhos-publico e peludinhos-privado.
# O público deve estar marcado como Public; o privado NÃO. O servidor confere isso ao iniciar e não sobe se estiver errado.
# SUPABASE_BUCKET_PUBLICO=peludinhos-publico
# SUPABASE_BUCKET_PRIVADO=peludinhos-privado
# Tempo máximo de cada operação com o Supabase, em milissegundos (1000 a 120000). Padrão: 15000.
# SUPABASE_TIMEOUT_MS=15000

# ---------------------------------------------------------------
# FRONTEND (usado só pelo Vite, no npm run dev, npm run build e npm run preview)
# Variáveis VITE_* são gravadas no JavaScript durante o build e ficam PÚBLICAS no navegador:
# nunca use esse prefixo para senhas, JWT_SECRET, URLs do banco ou chaves privadas.
# O build é interrompido se uma variável VITE_* tiver nome de segredo (SECRET, PASSWORD, KEY, TOKEN...).
# ---------------------------------------------------------------

# URL base do backend, SEM o /api final (o frontend acrescenta /api e usa a mesma base nas fotos /uploads).
# Vazia (padrão): caminhos relativos. No npm run dev e npm run preview, o proxy do Vite encaminha
# /api e /uploads para http://127.0.0.1:PORT; no npm run start:full, o próprio Express responde.
# Backend local em outra porta, sem proxy:  VITE_API_URL=http://127.0.0.1:3001
# Produção (backend hospedado):             VITE_API_URL=https://seu-backend.onrender.com
# Alterou o valor? Rode npm run build de novo: ele é fixado no momento do build.
VITE_API_URL=
